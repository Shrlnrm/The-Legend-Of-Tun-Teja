--- !u!114 &1639841928
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1639841926}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 82fc8764947867a44b4701eccd62352d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueTrigger
  conversation:
  - characterName: Malacca Sultan
    portrait: {fileID: 0}
    sentence: Hang Tuah, my trusted Laksamana. I have a task of great importance
      for you.
  - characterName: Hang Tuah
    portrait: {fileID: 0}
    sentence: Your wish is my command, Tuanku. I exist only to serve.
  - characterName: Malacca Sultan
    portrait: {fileID: 0}
    sentence: Tales of Tun Teja's beauty in Pahang have captured my heart. I desire
      her as my queen.
  - characterName: Malacca Sultan
    portrait: {fileID: 0}
    sentence: Go to Pahang. Use your wisdom and persuasion to bring her to Melaka.
  - characterName: Hang Tuah
    portrait: {fileID: 0}
    sentence: It is a heavy task, Tuanku, for she is loyal to her own land. But for
      you, I shall find a way.
  - characterName: Hang Tuah
    portrait: {fileID: 0}
    sentence: I will depart for Pahang at once. Tun Teja shall be yours.
  - characterName: Malacca Guard
    portrait: {fileID: 0}
    sentence: Do not fail me, Tuah. Go with haste.
  guardToActivate: {fileID: 1827678294}
  unlockDoorOnEnd: 1
  oneTimeOnly: 1
