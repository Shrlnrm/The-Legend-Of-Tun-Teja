      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 5008182277940300554, guid: 1d20ccd84470b1347a1d3e08e42931bc, type: 3}
      propertyPath: m_LocalEulerAnglesHint.z
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 6411766024104569524, guid: 1d20ccd84470b1347a1d3e08e42931bc, type: 3}
      propertyPath: unlockDoorOnEnd
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 6411766024104569524, guid: 1d20ccd84470b1347a1d3e08e42931bc, type: 3}
      propertyPath: conversation.Array.size
      value: 10
      objectReference: {fileID: 0}
    - target: {fileID: 6411766024104569524, guid: 1d20ccd84470b1347a1d3e08e42931bc, type: 3}
      propertyPath: conversation.Array.data[0].portrait
      value: 
      objectReference: {fileID: 9135109752481487698, guid: ec2a5d5d195ade645b242f8074847b08, type: 3}
    - target: {fileID: 6411766024104569524, guid: 1d20ccd84470b1347a1d3e08e42931bc, type: 3}
      propertyPath: conversation.Array.data[0].sentence
      value: Halt! Who approaches the royal gates of Tun Teja?
      objectReference: {fileID: 0}
    - target: {fileID: 6411766024104569524, guid: 1d20ccd84470b1347a1d3e08e42931bc, type: 3}
      propertyPath: conversation.Array.data[1].portrait
      value: 
      objectReference: {fileID: 21300000, guid: ba32495fe0ef4ba479509a9d0de3ddf5, type: 3}
    - target: {fileID: 6411766024104569524, guid: 1d20ccd84470b1347a1d3e08e42931bc, type: 3}
      propertyPath: conversation.Array.data[1].sentence
      value: I am Hang Tuah, Laksamana of Malacca. I have traveled far on the command
        of Sultan Mansur Shah.
      objectReference: {fileID: 0}
    - target: {fileID: 6411766024104569524, guid: 1d20ccd84470b1347a1d3e08e42931bc, type: 3}
      propertyPath: conversation.Array.data[2].portrait
      value: 
      objectReference: {fileID: 9135109752481487698, guid: ec2a5d5d195ade645b242f8074847b08, type: 3}
    - target: {fileID: 6411766024104569524, guid: 1d20ccd84470b1347a1d3e08e42931bc, type: 3}
      propertyPath: conversation.Array.data[2].sentence
      value: 'Malacca? We have no quarrel with your Sultan, but we are a land of
        peace... '
      objectReference: {fileID: 0}
    - target: {fileID: 6411766024104569524, guid: 1d20ccd84470b1347a1d3e08e42931bc, type: 3}
      propertyPath: conversation.Array.data[3].portrait
      value: 
      objectReference: {fileID: 9135109752481487698, guid: ec2a5d5d195ade645b242f8074847b08, type: 3}
    - target: {fileID: 6411766024104569524, guid: 1d20ccd84470b1347a1d3e08e42931bc, type: 3}
      propertyPath: conversation.Array.data[3].sentence
      value: What business does the mighty Laksamana have here?
      objectReference: {fileID: 0}
    - target: {fileID: 6411766024104569524, guid: 1d20ccd84470b1347a1d3e08e42931bc, type: 3}
      propertyPath: conversation.Array.data[4].portrait
      value: 
      objectReference: {fileID: 21300000, guid: ba32495fe0ef4ba479509a9d0de3ddf5, type: 3}
    - target: {fileID: 6411766024104569524, guid: 1d20ccd84470b1347a1d3e08e42931bc, type: 3}
      propertyPath: conversation.Array.data[4].sentence
      value: My business is of the highest importance and concerns both our royal
        houses...
      objectReference: {fileID: 0}
    - target: {fileID: 6411766024104569524, guid: 1d20ccd84470b1347a1d3e08e42931bc, type: 3}
      propertyPath: conversation.Array.data[5].portrait
      value: 
      objectReference: {fileID: 21300000, guid: ba32495fe0ef4ba479509a9d0de3ddf5, type: 3}
    - target: {fileID: 6411766024104569524, guid: 1d20ccd84470b1347a1d3e08e42931bc, type: 3}
      propertyPath: conversation.Array.data[5].sentence
      value: ' It is a private matter for Tun Teja''s ears alone.'
      objectReference: {fileID: 0}
    - target: {fileID: 6411766024104569524, guid: 1d20ccd84470b1347a1d3e08e42931bc, type: 3}
      propertyPath: conversation.Array.data[6].portrait
      value: 
      objectReference: {fileID: 9135109752481487698, guid: ec2a5d5d195ade645b242f8074847b08, type: 3}
    - target: {fileID: 6411766024104569524, guid: 1d20ccd84470b1347a1d3e08e42931bc, type: 3}
      propertyPath: conversation.Array.data[6].sentence
      value: I was not informed of any official visit. I cannot simply grant you
        entry to the Tuan Puteri.
      objectReference: {fileID: 0}
    - target: {fileID: 6411766024104569524, guid: 1d20ccd84470b1347a1d3e08e42931bc, type: 3}
      propertyPath: conversation.Array.data[7].portrait
      value: 
      objectReference: {fileID: 21300000, guid: ba32495fe0ef4ba479509a9d0de3ddf5, type: 3}
    - target: {fileID: 6411766024104569524, guid: 1d20ccd84470b1347a1d3e08e42931bc, type: 3}
      propertyPath: conversation.Array.data[7].sentence
      value: Time is a fickle master, Guard. My journey was fraught with danger...
      objectReference: {fileID: 0}
    - target: {fileID: 6411766024104569524, guid: 1d20ccd84470b1347a1d3e08e42931bc, type: 3}
      propertyPath: conversation.Array.data[8].portrait
      value: 
      objectReference: {fileID: 21300000, guid: ba32495fe0ef4ba479509a9d0de3ddf5, type: 3}
    - target: {fileID: 6411766024104569524, guid: 1d20ccd84470b1347a1d3e08e42931bc, type: 3}
      propertyPath: conversation.Array.data[8].sentence
      value: ' Delaying me further risks the message from the great Sultan.'
      objectReference: {fileID: 0}
    - target: {fileID: 6411766024104569524, guid: 1d20ccd84470b1347a1d3e08e42931bc, type: 3}
      propertyPath: conversation.Array.data[9].portrait
      value: 
      objectReference: {fileID: 9135109752481487698, guid: ec2a5d5d195ade645b242f8074847b08, type: 3}
    - target: {fileID: 6411766024104569524, guid: 1d20ccd84470b1347a1d3e08e42931bc, type: 3}
      propertyPath: conversation.Array.data[9].sentence
      value: Very well, Laksamana. Your name is well-known, and your word is trusted.
        I will allow you passage. She is inside. May your visit be brief and peaceful.
      objectReference: {fileID: 0}
    - target: {fileID: 6411766024104569524, guid: 1d20ccd84470b1347a1d3e08e42931bc, type: 3}
      propertyPath: conversation.Array.data[0].characterName
      value: ' Pahang Guard'
      objectReference: {fileID: 0}
    - target: {fileID: 6411766024104569524, guid: 1d20ccd84470b1347a1d3e08e42931bc, type: 3}
      propertyPath: conversation.Array.data[1].characterName
      value: Hang Tuah
      objectReference: {fileID: 0}
    - target: {fileID: 6411766024104569524, guid: 1d20ccd84470b1347a1d3e08e42931bc, type: 3}
      propertyPath: conversation.Array.data[2].characterName
      value: ' Pahang Guard'
      objectReference: {fileID: 0}
    - target: {fileID: 6411766024104569524, guid: 1d20ccd84470b1347a1d3e08e42931bc, type: 3}
      propertyPath: conversation.Array.data[3].characterName
      value: ' Pahang Guard'
      objectReference: {fileID: 0}
    - target: {fileID: 6411766024104569524, guid: 1d20ccd84470b1347a1d3e08e42931bc, type: 3}
      propertyPath: conversation.Array.data[4].characterName
      value: ' Hang Tuah'
