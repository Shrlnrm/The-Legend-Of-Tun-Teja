    - target: {fileID: 5008182277940300554, guid: 1d20ccd84470b1347a1d3e08e42931bc, type: 3}
      propertyPath: m_LocalEulerAnglesHint.y
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 5008182277940300554, guid: 1d20ccd84470b1347a1d3e08e42931bc, type: 3}
      propertyPath: m_LocalEulerAnglesHint.z
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 6411766024104569524, guid: 1d20ccd84470b1347a1d3e08e42931bc, type: 3}
      propertyPath: unlockDoorOnEnd
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 6411766024104569524, guid: 1d20ccd84470b1347a1d3e08e42931bc, type: 3}
      propertyPath: conversation.Array.size
      value: 17
      objectReference: {fileID: 0}
    - target: {fileID: 6411766024104569524, guid: 1d20ccd84470b1347a1d3e08e42931bc, type: 3}
      propertyPath: conversation.Array.data[0].sentence
      value: Tuan Puteri, forgive my intrusion.
      objectReference: {fileID: 0}
    - target: {fileID: 6411766024104569524, guid: 1d20ccd84470b1347a1d3e08e42931bc, type: 3}
      propertyPath: conversation.Array.data[1].sentence
      value: I come not as a warrior of Malacca, ....
      objectReference: {fileID: 0}
    - target: {fileID: 6411766024104569524, guid: 1d20ccd84470b1347a1d3e08e42931bc, type: 3}
      propertyPath: conversation.Array.data[2].sentence
      value: But as a man who has heard whispers of a beauty that outshines the moon.
      objectReference: {fileID: 0}
    - target: {fileID: 6411766024104569524, guid: 1d20ccd84470b1347a1d3e08e42931bc, type: 3}
      propertyPath: conversation.Array.data[3].sentence
      value: You are the famed Laksamana Hang Tuah.
      objectReference: {fileID: 0}
    - target: {fileID: 6411766024104569524, guid: 1d20ccd84470b1347a1d3e08e42931bc, type: 3}
      propertyPath: conversation.Array.data[4].sentence
      value: Why have you walked all this way from Melaka to my door?
      objectReference: {fileID: 0}
    - target: {fileID: 6411766024104569524, guid: 1d20ccd84470b1347a1d3e08e42931bc, type: 3}
      propertyPath: conversation.Array.data[5].sentence
      value: Surely not just to flatter me?
      objectReference: {fileID: 0}
    - target: {fileID: 6411766024104569524, guid: 1d20ccd84470b1347a1d3e08e42931bc, type: 3}
      propertyPath: conversation.Array.data[6].sentence
      value: Flattery is for courts and kings.
      objectReference: {fileID: 0}
    - target: {fileID: 6411766024104569524, guid: 1d20ccd84470b1347a1d3e08e42931bc, type: 3}
      propertyPath: conversation.Array.data[7].sentence
      value: I came because Melaka is a city of gold and glory, yet it is empty.
      objectReference: {fileID: 0}
    - target: {fileID: 6411766024104569524, guid: 1d20ccd84470b1347a1d3e08e42931bc, type: 3}
      propertyPath: conversation.Array.data[8].sentence
      value: It lacks a heart. The Sultan... he is a powerful man, but power is lonely.
      objectReference: {fileID: 0}
    - target: {fileID: 6411766024104569524, guid: 1d20ccd84470b1347a1d3e08e42931bc, type: 3}
      propertyPath: conversation.Array.data[9].sentence
      value: And what has that to do with me?
      objectReference: {fileID: 0}
    - target: {fileID: 6411766024104569524, guid: 1d20ccd84470b1347a1d3e08e42931bc, type: 3}
      propertyPath: conversation.Array.data[10].sentence
      value: I am betrothed to the Prince of Pahang.
      objectReference: {fileID: 0}
    - target: {fileID: 6411766024104569524, guid: 1d20ccd84470b1347a1d3e08e42931bc, type: 3}
      propertyPath: conversation.Array.data[11].sentence
      value: A prince may give you a crown, Tuan Puteri, but in Melaka you would
        give life to an empire.
      objectReference: {fileID: 0}
    - target: {fileID: 6411766024104569524, guid: 1d20ccd84470b1347a1d3e08e42931bc, type: 3}
      propertyPath: conversation.Array.data[12].sentence
      value: Your destiny is greater than this place. Come with me.
      objectReference: {fileID: 0}
    - target: {fileID: 6411766024104569524, guid: 1d20ccd84470b1347a1d3e08e42931bc, type: 3}
      propertyPath: conversation.Array.data[13].sentence
      value: "Are these truly the Sultan\u2019s words, or yours?"
      objectReference: {fileID: 0}
    - target: {fileID: 6411766024104569524, guid: 1d20ccd84470b1347a1d3e08e42931bc, type: 3}
      propertyPath: conversation.Array.data[14].sentence
      value: They are the truth. In Melaka, your name will live forever.
      objectReference: {fileID: 0}
    - target: {fileID: 6411766024104569524, guid: 1d20ccd84470b1347a1d3e08e42931bc, type: 3}
      propertyPath: conversation.Array.data[15].sentence
      value: Then I will trust you, Hang Tuah. Take me to Melaka.
      objectReference: {fileID: 0}
    - target: {fileID: 6411766024104569524, guid: 1d20ccd84470b1347a1d3e08e42931bc, type: 3}
      propertyPath: conversation.Array.data[16].sentence
      value: Wait for me outside
      objectReference: {fileID: 0}
    - target: {fileID: 6411766024104569524, guid: 1d20ccd84470b1347a1d3e08e42931bc, type: 3}
      propertyPath: conversation.Array.data[0].characterName
      value: Hang Tuah
      objectReference: {fileID: 0}
    - target: {fileID: 6411766024104569524, guid: 1d20ccd84470b1347a1d3e08e42931bc, type: 3}
      propertyPath: conversation.Array.data[1].characterName
      value: Hang Tuah
      objectReference: {fileID: 0}
    - target: {fileID: 6411766024104569524, guid: 1d20ccd84470b1347a1d3e08e42931bc, type: 3}
      propertyPath: conversation.Array.data[2].characterName
      value: Hang Tuah
      objectReference: {fileID: 0}
    - target: {fileID: 6411766024104569524, guid: 1d20ccd84470b1347a1d3e08e42931bc, type: 3}
      propertyPath: conversation.Array.data[3].characterName
      value: Tun Teja
      objectReference: {fileID: 0}
    - target: {fileID: 6411766024104569524, guid: 1d20ccd84470b1347a1d3e08e42931bc, type: 3}
      propertyPath: conversation.Array.data[4].characterName
