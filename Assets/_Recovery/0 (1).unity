--- !u!114 &521566656
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 521566654}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\"Hang Tuah\u2019s blade flashed one last time against his former allies,
    clearing the path back to Pahang. Standing at the palace entrance, Tun Teja was
    safe, saved not by the Sultan\u2019s power, but by Hang Tuah's rediscovered honor.
    The Laksamana had chosen truth over loyalty. He became a fugitive, his name forever
    stained with the word 'Traitor' in Malacca, but remembered as a hero in Pahang.
    Tun Teja, returned to her home, lived a life of peace and dignity, forever grateful
    to the warrior who risked everything. Hang Tuah vanished into the wilderness,
    his fate a mystery, achieving a greater victory in conscience than any battlefield
    could offer.\"\n\n                                                             
    Press T to skip"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 241c6acceca8b844baad6cbcf60cefc7, type: 2}
