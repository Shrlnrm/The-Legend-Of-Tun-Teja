# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore
#
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uilds/
[Ll]ogs/
[Uu]serSettings/

# MemoryDumps can get quite large and should be excluded
MemoryCaptures/

# Asset meta files must be tracked in Unity projects
# !*.meta

# Uncomment this line if you wish to ignore the asset store index file
# /[Aa]ssets/AssetStoreTools*

# Autogenerated JetBrains Rider plugin files
.idea/

# Visual Studio cache directory
.vs/

# Gradle cache directory
.gradle/

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file extensions to ignore
*.unitypackage
*.apk
*.unityexp
*.bundle

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Allow the Build folder as requested by the user
# [Bb]uild/ is NOT ignored here to ensure it's pushed.
